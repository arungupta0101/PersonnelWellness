# Secret Key & JWT Config
SECRET_KEY=change_this_to_a_secure_random_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Connection
DATABASE_URL=sqlite:///./wellness.db

